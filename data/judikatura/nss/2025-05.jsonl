{"ai":{"at":"2026-09-25T07:52:30Z","heslo":"Odkladný účinek","model":"ručně","oblasti":["socialni_cizinci"],"procesni":true,"pv":1,"shrnuti":"Žadatelka o mezinárodní ochranu, jejíž žádost Ministerstvo vnitra podle nařízení Dublin III shledalo nepřípustnou (příslušná je Francie), žádala o přiznání odkladného účinku kasační stížnosti. NSS návrh zamítl, protože obecný zájem na osobní účasti v řízení ani samotná povinnost vycestovat bez dalších konkrétních a osvědčených důvodů podle usnesení rozšířeného senátu 8 Azs 339/2019 nestačí. Zároveň upozornil ministerstvo, že odkladný účinek lze přiznat i tehdy, když o něm krajský soud nerozhodoval.","tv":2,"zdroj":"dawmain"},"bootstrap":true,"cast":"","datum":"2025-05-28","druh":"usnesení","ecli":"ECLI:CZ:NSS:2025:2.Azs.91.2025.23","first_seen":"2025-05-28T12:00:00Z","id":"nss:741995","jazyk":"cs","meta":{"oblast_upravy":"Azyl - Mezinárodní ochrana a setrvání v přijímacím středisku","senat_nss":"tříčlenný senát NSS","soudce":"Eva Šonková","spravni_organ":"Ministerstvo vnitra","typ_rizeni":"žaloba proti rozhodnutí","ucastnici":"Ministerstvo vnitra, xxx","vyrok":"odkladný účinek: nepřiznání","zpristupneno":"2026-09-17"},"nahrazeno":null,"nazev":"","oblasti_meta":["socialni_cizinci"],"pdf":"https://vyhledavac.nssoud.cz/DokumentOriginal/Index/741995","procesni_meta":true,"rejstrik":"Azs","senat":2,"soud":"nss","spz":"2 Azs 91/2025-23","spz_klic":"2azs91/2025-23","stav":{"dalsi_pokus":null,"duvod":null,"pokusy":0},"url":"https://vyhledavac.nssoud.cz/DokumentOriginal/Html/741995","zverejneno":"2025-05-28"}
