# Políčka pro secrets newsletteru (Settings -> Secrets and variables -> Actions).
#
# Tenhle soubor je jen předloha – vyplň si ji stranou a hodnoty pak vlož do
# GitHubu jako repository secrets pod stejnými názvy. NIKDY sem nepiš skutečné
# heslo a necommituj ho: soubor je v repozitáři veřejně čitelný.
#
# Povinné je jen MAIL_SMTP_HOST, MAIL_USERNAME, MAIL_PASSWORD a MAIL_TO.
# Dokud nejsou vyplněné, workflow doběhne, jen nic nepošle.

# --- Server ---------------------------------------------------------------
# Gmail: smtp.gmail.com | Seznam: smtp.seznam.cz | Fastmail: smtp.fastmail.com
MAIL_SMTP_HOST=

# 587 = STARTTLS (obvyklé), 465 = SMTPS. Prázdné = 587.
MAIL_SMTP_PORT=

# --- Přihlášení -----------------------------------------------------------
# Celá e-mailová adresa, kterou se k SMTP přihlašuješ.
MAIL_USERNAME=

# U Gmailu i Seznamu heslo aplikace, ne heslo k účtu (viz NEWSLETTER.md).
MAIL_PASSWORD=

# --- Zpráva ---------------------------------------------------------------
# Odesílatel. Prázdné = použije se MAIL_USERNAME.
MAIL_FROM=

# Příjemci – oddělené čárkou, středníkem nebo novým řádkem.
# Adresy jdou do Bcc, takže je jeden druhému neuvidí.
MAIL_TO=

# Nepovinné: odkaz na odhlášení do patičky a hlavičky List-Unsubscribe.
# U ručně vedeného seznamu klidně mailto: adresa, kam se lidé ozvou.
MAIL_UNSUBSCRIBE_URL=

# Nepovinné: jak starý přehled ještě poslat, ve dnech (výchozí 3).
MAIL_MAX_AGE_DAYS=
